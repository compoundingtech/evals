agent "global.coding-agents.session-creation.interview-eval" {
  identity "global.coding-agents.session-creation.interview-eval"
  host "evalhost"
  workspace "$CATALOG/interviewer"

  restart {
    attempts 3
    interval "60s"
    delay "0s"
    mode "delay"
  }

  env {
    AGENT_LAUNCH_HOSTED "1"
    AGENT_PERSONA "session-creator"
    AGENT_RUNTIME_PROFILE "@PROFILE@"
    ST_AGENT "evalhost.global.coding-agents.session-creation.interview-eval"
  }

  argv "@ADAPTER@" "agent" "launch" "--harness" "claude" "--model" "claude-sonnet-5" "--effort" "medium" "--persona" "session-creator" "--mode" "managed-unattended" "--boot" "managed-v1"
  ding

  render {
    copy "_templates/session-creator.md" ".st2/PERSONA.md"
    copy "_templates/bus.st2.md" ".st2/bus.md"
    git-exclude ".st2/"
  }
}
