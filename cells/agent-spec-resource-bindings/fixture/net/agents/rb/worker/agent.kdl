agent "worker" {
  host "rb"
  role "worker"
  workspace "$CATALOG"

  resource "work" _tag="github-issue" uri="github-issue://example/project/41?view=exact%20bytes"
  resource "context" _tag="vendor-specific-v7" uri="vendor+thing://authority/context%2Fone"

  pty "agent" {
    id "rb.worker"
    command "exec tail -f /dev/null"
  }
}
