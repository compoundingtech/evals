schema "agent-spec.experimental/v1"

agent "a" {
  resource "work" uri="github-issue://eval/widget-normalization"
  resource "source" uri="worktree://eval/widget"
  resource "worklog" uri="axe-worklog://eval/widget-normalization"
  resource "delivery" uri="ding://eval/arh.a"
}

agent "b" {
  resource "work" uri="github-issue://eval/widget-normalization"
  resource "source" uri="worktree://eval/widget"
  resource "worklog" uri="axe-worklog://eval/widget-normalization"
  resource "delivery" uri="ding://eval/arh.b"
  focus "work"
}
