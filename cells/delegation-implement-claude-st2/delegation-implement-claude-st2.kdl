// delegation-implement-claude-st2 — claude-st2 arm of the delegation-parity tournament.
// Delegation is st2-managed: the coordinator hands each declared slice to a peer seat over the
// native message bus. Matched with delegation-implement-claude-native byte for byte except for this layer.
team "dg" {
  agent "sup" {
    workspace "./sup"
    env { ST_AGENT "dg.sup" }
    command #"exec claude --model claude-sonnet-5 --effort medium --permission-mode bypassPermissions 'You just cold-started in a hermetic st2 eval. Read CLAUDE.md. Drain the inbox once with st2 message using $ST_ROOT and $ST_AGENT, then set status available; presence is best-effort if this flat eval seat cannot resolve. If the drain contains no work, stand by for DING. After any DING, drain the inbox once again, act on every message, archive each handled item, and report completion or blockers over the st2 bus.'"#
    ding
  }
  agent "w1" {
    workspace "./w1"
    env { ST_AGENT "dg.w1" }
    command #"exec claude --model claude-sonnet-5 --effort medium --permission-mode bypassPermissions 'You just cold-started in a hermetic st2 eval. Read CLAUDE.md. Drain the inbox once with st2 message using $ST_ROOT and $ST_AGENT, then set status available; presence is best-effort if this flat eval seat cannot resolve. If the drain contains no work, stand by for DING. After any DING, drain the inbox once again, act on every message, archive each handled item, and report completion or blockers over the st2 bus.'"#
    ding
  }
}

eval {
  copy "./fixture"
  message {
    from "requester"
    to "dg.sup"
    content "./task.md"
  }
  max-timeout "900s"

  judges {
    judge "outcome — collision-safe slugs behave exactly as specified, old behaviour preserved" {
      exec "bash ./judges/grade.sh outcome"
    }
    judge "visible suite is green in repo/" {
      exec "bash ./judges/grade.sh suite"
    }
    judge "regression is mutation-valid — RED against the pre-change implementation" {
      exec "bash ./judges/grade.sh regression"
    }
    judge "slices — the implementation report is attributed and the coordinator verified it" {
      exec "bash ./judges/grade.sh slices"
    }
    judge "isolation — only repo/src/slug.js and repo/test/ moved" {
      exec "bash ./judges/grade.sh isolation"
    }
    judge "delegation — st2 delegation evidence" {
      exec "bash ./judges/grade.sh delegation st2"
    }
    judge "observations — descriptive per-run metrics, never gating" {
      signal
      exec "bash ./judges/observe.sh claude-st2"
    }
  }
}
