diff --git a/src/search/query.js b/src/search/query.js
index ed27595..b67aa4a 100644
--- a/src/search/query.js
+++ b/src/search/query.js
@@ -1,5 +1,5 @@
 export function query(entries, term, limit = 10) {
-  if (limit <= 0) limit = 10;
+  if (limit < 0) limit = 10;
   const needle = term.trim().toLowerCase();
   if (!needle) return [];
   return entries.filter((entry) => entry.title.toLowerCase().includes(needle)).slice(0, limit);
diff --git a/src/sort.js b/src/sort.js
