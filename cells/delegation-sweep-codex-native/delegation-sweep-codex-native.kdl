// delegation-sweep-codex-native — codex-native arm of the delegation-parity tournament.
// Delegation is harness-native: one bus seat fans the declared slices out to its own codex
// sub-agents. Matched with delegation-sweep-codex-st2 byte for byte except for this layer.
team "dg" {
  agent "sup" {
    workspace "./sup"
    env { ST_AGENT "dg.sup" }
    command #"exec codex --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust --model gpt-5.6-sol -c 'model_reasoning_effort="medium"' 'You cold-started in a hermetic st2 eval. Read AGENTS.md. Drain the inbox once using st2 message, then set status available; presence failure is non-blocking. If there is no work, stand by for DING. After any DING, drain again, act on every message, archive each handled item, and report completion or blockers over the st2 bus.'"#
    ding
  }
}

eval {
  copy "./fixture"
  message {
    from "requester"
    to "dg.sup"
    content "./task.md"
  }
  max-timeout "900s"

  judges {
    judge "outcome — the summary names exactly the modules that reach legacyTitle()" {
      exec "bash ./judges/grade.sh outcome"
    }
    judge "slices — both slice deliverables are attributed, distinct, and independently correct" {
      exec "bash ./judges/grade.sh slices"
    }
    judge "isolation — the audited repository is byte-identical to the frozen baseline" {
      exec "bash ./judges/grade.sh isolation"
    }
    judge "delegation — native delegation evidence" {
      exec "bash ./judges/grade.sh delegation native"
    }
    judge "observations — descriptive per-run metrics, never gating" {
      signal
      exec "bash ./judges/observe.sh codex-native"
    }
  }
}
