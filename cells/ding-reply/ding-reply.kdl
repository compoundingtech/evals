// ding-reply.kdl — the whole eval in one file. `st2 eval ./` runs it.
// Covers the no-MCP THREADED REPLY path: a ding-only Claude agent receives a message and replies on the
// thread via `st2 message reply`, so the reply lands `in-reply-to:` the original. The fixture intentionally
// pre-seeds CLAUDE.md -> PERSONA.md. Bare `ding` delegates wake wiring to the current st2 folder-eval
// renderer; the cell authors no compatibility bus root or sidecar command. All judges are held out.

team "dr" {                              // single agent -> dr.agent
  agent "agent" {
    workspace "./work"                   // its cwd holds ANSWER.txt
    env { ST_AGENT "dr.agent" }
    command #"exec claude --model claude-sonnet-5 --effort medium --permission-mode auto 'You just cold-started in a hermetic st2 eval. Read CLAUDE.md. Drain the inbox once with st2 message using $ST_ROOT and $ST_AGENT. If it contains no work, set status available and stand by for DING; presence is best-effort if status cannot resolve this flat eval seat. After any DING, drain the inbox, act on every message, and archive each handled item. Execute the request and reply on its existing thread. Report completion or blockers over the st2 bus.'"#
    ding
  }
}

eval {
  copy "./fixture"                       // work/ANSWER.txt + the persona
  message {                              // the kick — asks for a threaded reply carrying ANSWER.txt
    from "dr-req"
    to "dr.agent"
    content "./task.md"
  }
  max-timeout "420s"                     // single-agent, no sup->requester done-signal → judges final state at the cap

  judges {                               // all must pass; each one visible, nothing magic
    judge "THREADED REPLY (held-out) — dr.agent replied to dr-req in-reply-to the kick, carrying the ANSWER token (not a fresh send)" {
      exec "bash ./judges/threaded-reply.sh"
    }
    judge "no MCP — the agent has no .mcp.json (ding + st2 CLI only)" {
      exec "bash ./judges/no-mcp.sh"
    }
  }
}
