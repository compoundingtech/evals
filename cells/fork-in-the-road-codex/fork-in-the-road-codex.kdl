// fork-in-the-road-codex.kdl — the codex twin of fork-in-the-road. `st2 eval ./` runs it.
// Same DESIGN cell (a team designs how MULTIPLE humans share one agent team — N distinct approaches, a real
// debate, a justified recommendation, and the held-out PRIVACY / information-isolation crux) but the panel is
// run by CODEX agents (gpt-5.6-sol). Each fixture workspace intentionally pre-seeds AGENTS.md, and bare
// `ding` is the native st2 wake declaration. Cross-model probe: does codex complete the full 4-agent design
// panel? Same held-out judges as the base (fd.* ids + authors).

// Harness loaders, personas, and hooks are intentionally baked into fixture workspaces;
// bin/check-harness-contract.sh verifies every current bus-connected model agent.
team "fd" {                              // -> fd.sup (synthesizer) + fd.a / fd.b / fd.c (proposers)
  agent "sup" {
    workspace "./sup"                    // coordinate + synthesize; owns only RECOMMENDATION.md in its dir
    env { ST_AGENT "fd.sup" }
    command #"exec codex --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust --model gpt-5.6-sol -c 'model_reasoning_effort="medium"' 'You just cold-started in a hermetic st2 eval. Read AGENTS.md. Drain the inbox once with st2 message using $ST_ROOT and $ST_AGENT, then set status available; presence is best-effort if this flat eval seat cannot resolve. If the drain contains no work, stand by for DING. After any DING, drain the inbox once again, act on every message, archive each handled item, and drive the complete panel, synthesis, and handoff. Report completion or blockers over the st2 bus.'"#
    ding
  }
  agent "a" {
    workspace "./a"
    env { ST_AGENT "fd.a" }
    command #"exec codex --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust --model gpt-5.6-sol -c 'model_reasoning_effort="medium"' 'You just cold-started in a hermetic st2 eval. Read AGENTS.md. Drain the inbox once with st2 message using $ST_ROOT and $ST_AGENT, then set status available; presence is best-effort if this flat eval seat cannot resolve. If the drain contains no work, stand by for DING. After any DING, drain the inbox once again, act on every message, archive each handled item, then execute, debate, commit, and report end-to-end. Report completion or blockers over the st2 bus.'"#
    ding
  }
  agent "b" {
    workspace "./b"
    env { ST_AGENT "fd.b" }
    command #"exec codex --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust --model gpt-5.6-sol -c 'model_reasoning_effort="medium"' 'You just cold-started in a hermetic st2 eval. Read AGENTS.md. Drain the inbox once with st2 message using $ST_ROOT and $ST_AGENT, then set status available; presence is best-effort if this flat eval seat cannot resolve. If the drain contains no work, stand by for DING. After any DING, drain the inbox once again, act on every message, archive each handled item, then execute, debate, commit, and report end-to-end. Report completion or blockers over the st2 bus.'"#
    ding
  }
  agent "c" {
    workspace "./c"
    env { ST_AGENT "fd.c" }
    command #"exec codex --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust --model gpt-5.6-sol -c 'model_reasoning_effort="medium"' 'You just cold-started in a hermetic st2 eval. Read AGENTS.md. Drain the inbox once with st2 message using $ST_ROOT and $ST_AGENT, then set status available; presence is best-effort if this flat eval seat cannot resolve. If the drain contains no work, stand by for DING. After any DING, drain the inbox once again, act on every message, archive each handled item, then execute, debate, commit, and report end-to-end. Report completion or blockers over the st2 bus.'"#
    ding
  }
}

eval {
  copy "./fixture"                       // 4 dirs, each _git -> .git on copy, each with the shared PROBLEM.md + AGENTS.md
  message {
    from "requester"
    to "fd.sup"
    content "./task.md"
  }
  max-timeout "1200s"

  judges {                               // all held-out; same graders as the base (fd.* ids + authors)
    judge "isolation — each dir authored only by its owning agent (fd.<role>); nobody edits another's dir" {
      exec "bash ./judges/isolation.sh"
    }
    judge "deliverables — >=2 non-empty PROPOSAL.md (a/b/c) committed AND a non-empty RECOMMENDATION.md (sup)" {
      exec "bash ./judges/deliverables.sh"
    }
    judge "distinct — the proposals are not near-duplicates (a real option space, >=2 distinct texts)" {
      exec "bash ./judges/distinct.sh"
    }
    judge "PRIVACY HOOK (held-out) — cross-human privacy / information-isolation is surfaced as a first-class tradeoff" {
      exec "bash ./judges/privacy.sh"
    }
    judge "recommendation — a justified recommendation reached the requester on the bus" {
      exec "bash ./judges/recommendation.sh"
    }
  }
}
