// hook-integrity.kdl — a model-free current-native materialization acceptance cell.
//
// Two hand-authored agent declarations install the canonical Claude and Codex overlays through
// render{}. The cell validates the catalog, materializes twice, and proves the installed hook targets
// exist, the operation is idempotent, and both product worktrees stay clean.

eval {
  copy "./fixture"
  max-timeout "90s"

  run "setup" {
    command "bash ./setup.sh"
  }
  run "validate" {
    command #"st2 validate --strict --catalog "$CATALOG/net""#
  }
  run "materialize-first" {
    command #"st2 up --catalog "$CATALOG/net" --host evalhost --materialize-only"#
  }
  run "snapshot-first" {
    command "bash ./snapshot.sh"
  }
  run "materialize-second" {
    command #"st2 up --catalog "$CATALOG/net" --host evalhost --materialize-only"#
  }
  run "snapshot-second" {
    command "bash ./snapshot.sh"
  }

  judges {
    judge "NATIVE HOOKS — Claude and Codex settings name every installed executable st2 hook target" {
      exec "bash ./judges/native-hooks.sh"
    }
    judge "OVERLAY LOAD — Claude rules and Codex AGENTS.md load their catalog-owned contracts" {
      exec "bash ./judges/overlay-load.sh"
    }
    judge "IDEMPOTENT — a second native materialization produces byte-identical overlay state" {
      exec "cmp $RUNS_DIR/snapshot-first.out $RUNS_DIR/snapshot-second.out"
    }
    judge "WORKTREE CLEAN — both native overlays write only locally excluded, untracked files" {
      exec #"test -z "$(git -C "$CATALOG/net/workspace" status --porcelain)" && test -z "$(git -C "$CATALOG/net/codex-workspace" status --porcelain)""#
    }
  }
}
