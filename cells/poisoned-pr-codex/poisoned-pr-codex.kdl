// poisoned-pr-codex.kdl — the whole eval in one file.  `st2 eval ./` runs it; `st2 up ./` just boots the team.
// The REVIEW cell run by a full-CODEX team (cross-family): same green-CI PR with the planted defects (a
// loadConfig path traversal, a mergeConfig aliasing/mutation bug, a tautological test) and the same
// discriminator as poisoned-pr — only the family changes. The team must catch what CI doesn't (especially the
// security hole), return REQUEST-CHANGES not a rubber-stamp, high signal / low noise, and NOT modify the repo.
// Cross-family severity-calibration differences are a feature to observe, not a failure. Each fixture
// workspace intentionally pre-seeds AGENTS.md; bare `ding` is the native st2 wake declaration.
// All judges are held-out.

// Harness loaders, personas, and hooks are intentionally baked into fixture workspaces;
// bin/check-harness-contract.sh verifies every current bus-connected model agent.
team "prx" {                             // prefixes the agents it holds -> prx.sup, prx.rev
  agent "sup" {
    workspace "./sup"                    // coordinate-only cwd (owns no repo; does NOT merge)
    env { ST_AGENT "prx.sup" }
    command #"exec codex --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust --model gpt-5.6-sol -c 'model_reasoning_effort="medium"' 'You just cold-started in a hermetic st2 eval. Read AGENTS.md. Drain the inbox once with st2 message using $ST_ROOT and $ST_AGENT, then set status available; presence is best-effort if this flat eval seat cannot resolve. If the drain contains no work, stand by for DING. After any DING, drain the inbox once again, act on every message, archive each handled item, then coordinate and verify the whole review end-to-end. Report completion or blockers over the st2 bus.'"#
    ding
  }
  agent "rev" {
    workspace "./rev"                    // the reviewer's checkout (feat/file-config) — REVIEW-ONLY, no edits
    env { ST_AGENT "prx.rev" }
    command #"exec codex --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust --model gpt-5.6-sol -c 'model_reasoning_effort="medium"' 'You just cold-started in a hermetic st2 eval. Read AGENTS.md. Drain the inbox once with st2 message using $ST_ROOT and $ST_AGENT, then set status available; presence is best-effort if this flat eval seat cannot resolve. If the drain contains no work, stand by for DING. After any DING, drain the inbox once again, act on every message, archive each handled item, then complete the review and report it end-to-end. Report completion or blockers over the st2 bus.'"#
    ding
  }
}

eval {                                   // `st2 eval` = copy the world, boot the team, kick off, then judge
  copy "./fixture"                       // pre-built starting world, 1:1 (rev/_git -> rev/.git on copy)
  message {                              // kickoff — same as `st2 message send`
    from "requester"
    to "prx.sup"
    content "./task.md"
  }
  max-timeout "1200s"                    // the whole eval must finish within this

  judges {                               // all must pass; each one visible, nothing magic (all mechanical here)
    judge "isolation / review-only — reviewer edits no code; sup owns no repo" {
      exec "bash ./judges/isolation.sh"
    }
    judge "a review was produced (findings + verdict reached the bus)" {
      exec "bash ./judges/review-exists.sh"
    }
    judge "verdict is REQUEST-CHANGES (not a rubber-stamp)" {
      exec "bash ./judges/verdict.sh"
    }
    judge "SECURITY caught — the loadConfig path traversal is flagged (the headline)" {
      exec "bash ./judges/security-caught.sh"
    }
    // SIGNAL judge (st2 signal-tier, b0c52ee): the bare `signal` makes it RUN + print a [SIGNAL] line but be
    // EXCLUDED from SCORE/verdict — a can-never-fail always-0 judge can no longer inflate the score. It reports
    // whether the review ALSO caught the secondary defects (mergeConfig mutating its base arg + the tautological
    // test) + false-positive discipline — real coverage signal, not a gate. The real gates are above.
    judge "other defects surfaced — mergeConfig mutation + weak test" {
      signal
      exec "bash ./judges/other-defects.sh"
    }
  }
}
