// signal-rename.kdl — the whole eval in one file.  `st2 eval ./` runs it.
//
// The cross-repo coordination crown-jewel: a 4-agent tree (sig.sup + a specialist per package — sig.base,
// sig.relay, sig.hub) carries out a coordinated PRODUCT rename `signal`→`beacon` across a base package + two
// consumers + a config sweep, keeping every suite green and the renamed stack working end-to-end. The three
// skills tested: DECOMPOSITION (who owns which package), SEQUENCING (base first + a compat/alias window so
// consumers never reference a name the base no longer provides), and JUDGMENT (`signal` also names a PRIMITIVE —
// AbortSignal/controller.signal/SIGTERM — that must NOT be renamed; a blind s/signal/beacon/g fails).
//
// The workspace is a bare origin + one full clone per agent (distinct authors → isolation is attributable), so
// clones carry absolute origin URLs — a `run { step }` materializes it in-place BEFORE boot (a static fixture
// can't). The materializer installs CLAUDE.md -> PERSONA.md in every clone. Native bare `ding` delegates wake
// wiring to st2; the cell authors no compatibility bus root or sidecar command. Each agent commits + pushes
// ONLY its lane to origin/main; the judges integrate on sig.sup's clone. The cross-repo acceptance test is
// HELD OUT (no agent sees it). All 5 judges are held out.

team "sig" {                             // -> sig.sup (integration lead) + sig.base / sig.relay / sig.hub (specialists)
  agent "sup" {
    workspace "./sup"                    // owns config/ + workspace root + integration on main (materialized below)
    env { ST_AGENT "sig.sup" }
    command #"exec claude --model claude-sonnet-5 --effort medium --permission-mode bypassPermissions 'You just cold-started in a hermetic st2 eval. Read CLAUDE.md. Drain the inbox once with st2 message using $ST_ROOT and $ST_AGENT, then set status available; presence is best-effort if this flat eval seat cannot resolve. If the drain contains no work, stand by for DING. After any DING, drain the inbox once again, act on every message, and archive each handled item. On the rename request, immediately send each of sig.base, sig.relay, and sig.hub a clear go with its task (base first, dual-honor alias window); do your own config lane; actively follow up; integrate; and send morgan one final report only when the whole rename is done, every suite is green, and no product signal remains. Report completion or blockers over the st2 bus.'"#
    ding
  }
  agent "base" {
    workspace "./base"                   // owns signal/ (the base package @acme/signal + the `signal` bin)
    env { ST_AGENT "sig.base" }
    command #"exec claude --model claude-sonnet-5 --effort medium --permission-mode bypassPermissions 'You just cold-started in a hermetic st2 eval. Read CLAUDE.md. Drain the inbox once with st2 message using $ST_ROOT and $ST_AGENT, then set status available; presence is best-effort if this flat eval seat cannot resolve. If the drain contains no work, stand by for DING. After any DING, drain the inbox once again, act on every message, and archive each handled item. Execute the full base-package task in the same event turn, keep node --test green, commit and push only your lane to origin main, and report to sig.sup. Report completion or blockers over the st2 bus.'"#
    ding
  }
  agent "relay" {
    workspace "./relay"                  // owns signal-relay/ (the PRIMITIVE-trap consumer)
    env { ST_AGENT "sig.relay" }
    command #"exec claude --model claude-sonnet-5 --effort medium --permission-mode bypassPermissions 'You just cold-started in a hermetic st2 eval. Read CLAUDE.md. Drain the inbox once with st2 message using $ST_ROOT and $ST_AGENT, then set status available; presence is best-effort if this flat eval seat cannot resolve. If the drain contains no work, stand by for DING. After any DING, drain the inbox once again, act on every message, and archive each handled item. Execute the full relay task in the same event turn: rename product references but preserve AbortSignal, controller.signal, and SIGTERM; keep node --test green; pull the base change; commit and push only your lane; and report to sig.sup. Report completion or blockers over the st2 bus.'"#
    ding
  }
  agent "hub" {
    workspace "./hub"                    // owns signal-hub/ (the signal:// resource scheme)
    env { ST_AGENT "sig.hub" }
    command #"exec claude --model claude-sonnet-5 --effort medium --permission-mode bypassPermissions 'You just cold-started in a hermetic st2 eval. Read CLAUDE.md. Drain the inbox once with st2 message using $ST_ROOT and $ST_AGENT, then set status available; presence is best-effort if this flat eval seat cannot resolve. If the drain contains no work, stand by for DING. After any DING, drain the inbox once again, act on every message, and archive each handled item. Execute the full hub task in the same event turn: rename product references and signal:// to beacon://; keep node --test green; pull the base change; commit and push only your lane; and report to sig.sup. Report completion or blockers over the st2 bus.'"#
    ding
  }
}

eval {
  copy "./fixture"                       // seed-graph/ + personas/ + materialize.sh + task.md
  run "materialize" {                    // build the bare origin + 4 authored clones + hold out the e2e test
    command #"bash ./materialize.sh"#
  }
  message {                              // the kick — the rename request to the integration lead
    from "morgan"
    to "sig.sup"
    content "./task.md"
  }
  max-timeout "1800s"                    // a real 4-agent cross-repo rename with sequencing; judges final state at the cap

  judges {                              // all held-out; all must pass
    judge "ISOLATION — every commit stayed in its author's package lane (base/relay/hub/sup); no cross-lane edit" {
      exec "bash ./judges/isolation.sh"
    }
    judge "SUITE GREEN — node --test passes in every package on integrated main" {
      exec "bash ./judges/suite-green.sh"
    }
    judge "RENAME — product fully renamed to beacon (package + scheme + protocol), no lingering product 'signal'" {
      exec "bash ./judges/rename.sh"
    }
    judge "PRIMITIVE INTACT (the trap) — AbortSignal / controller.signal / SIGTERM survive undamaged in the relay" {
      exec "bash ./judges/primitive.sh"
    }
    judge "HELD-OUT E2E — a rename-agnostic driver resolves the renamed base+relay+hub end-to-end" {
      exec "bash ./judges/e2e.sh"
    }
  }
}
