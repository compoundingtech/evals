#!/usr/bin/env bash
set -euo pipefail
count_file="${FAKE_ST2_COUNT_FILE:?FAKE_ST2_COUNT_FILE is required}"
count=0
test ! -f "$count_file" || count="$(cat "$count_file")"
count=$((count + 1))
printf '%s' "$count" >"$count_file"
if test "$count" -le "${FAKE_ST2_FAILURES:-2}"; then
  echo "injected transient st2 ingress failure $count" >&2
  exit 69
fi
exec "${REAL_ST2:?REAL_ST2 is required}" "$@"
